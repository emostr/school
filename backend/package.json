{
  "name": "edway-backend",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "edway.space — API школьной платформы",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "dev": "prisma generate && nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "type-check": "prisma generate && tsc --noEmit",
    "admin:init": "node scripts/admin-init.mjs",
    "admin:reset": "node scripts/admin-reset.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "sharp": true
  }
}
