DATABASE_URL="postgresql://edway:edway@localhost:5432/edway?schema=public"
JWT_SECRET="сгенерируйте: openssl rand -base64 48"
PORT=3100
NODE_ENV=development

# Публичный адрес: по его схеме выставляется флаг Secure у cookie сессии.
PUBLIC_URL="http://localhost:4200"

# Разрешённые источники для CORS. В проде не нужно: интерфейс и API на одном домене.
FRONTEND_ORIGIN="http://localhost:4200"

# Каталог со сканами, картинками и вложениями.
UPLOAD_DIR="./uploads"

SESSION_DAYS=30
