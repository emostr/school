# Переменные стека для docker compose. На сервере этот файл пишет deploy.sh
# из deploy.conf — править его руками не нужно.

POSTGRES_USER=edway
POSTGRES_PASSWORD=edway
POSTGRES_DB=edway

JWT_SECRET=change-me-in-production

# Публичный адрес. По его схеме выставляется флаг Secure у cookie сессии:
# https — ставим, http — нет (иначе Safari выбросит cookie).
PUBLIC_URL=http://localhost:8030

# Порт, на котором контейнер web ждёт запросы от NGINX хоста.
HTTP_PORT=8030
HTTP_BIND=127.0.0.1

# Сколько дней живёт сессия.
SESSION_DAYS=30

# Логин системного администратора. Пароль выдаёт deploy.sh (admin:init).
ADMIN_LOGIN=admin
# Имя в приложении-аутентификаторе.
TOTP_ISSUER=edway.space

# Попыток входа в минуту с одного адреса.
LOGIN_RATE_LIMIT=20
