# Конфигурация развёртывания edway.space
# Скопируйте файл в deploy.conf, заполните значения и запустите: sudo ./deploy.sh
# Файл сгенерирован ИИ-агентом Anthropic Claude Opus 5.5.
#
# Значения читаются как есть: кавычки вокруг строк с пробелами не нужны,
# но и не мешают.

# --- Домен и сертификат -----------------------------------------------------

# Домен, на котором будет работать платформа. A-запись должна указывать на
# этот сервер ещё до запуска — иначе Let's Encrypt не выдаст сертификат.
DOMAIN=school.example.ru

# Почта для Let's Encrypt: на неё приходят предупреждения об истечении.
ACME_EMAIL=admin@example.ru

# letsencrypt — бесплатный сертификат, выпускается и продлевается certbot;
# selfsigned — самоподписанный (закрытая сеть, тесты): браузер предупредит;
# off        — только HTTP, без шифрования (если перед сервером свой прокси).
TLS_MODE=letsencrypt

# yes — выпускать сертификат в тестовом окружении Let's Encrypt: браузеры ему
# не доверяют, зато лимиты выпуска мягче. Удобно, пока проверяете развёртывание.
LETSENCRYPT_STAGING=no

# --- Расположение и порты ---------------------------------------------------

# Каталог, из которого будет работать платформа. Если он отличается от
# каталога со скриптом, исходники будут скопированы туда.
APP_DIR=/opt/edway

# Локальный порт, на котором контейнер web ждёт запросы от NGINX хоста.
# Должен быть свободен: скрипт это проверит.
HTTP_PORT=8030

# 127.0.0.1 — снаружи платформа доступна только через NGINX по HTTPS.
HTTP_BIND=127.0.0.1

# --- Системные пакеты -------------------------------------------------------

INSTALL_DOCKER=yes
INSTALL_NGINX=yes

# Остановить Caddy или Apache, если они занимают порты 80/443.
# Их конфигурация сохраняется в резервную копию перед отключением.
DISABLE_CONFLICTING=yes

# ufw — открыть 80, 443 и порт SSH, затем включить фаервол; no — не трогать.
# Внимание: проверьте SSH_PORT, иначе потеряете доступ к серверу.
FIREWALL=no
SSH_PORT=22

# --- Секреты ----------------------------------------------------------------
# Пустое значение: взять из существующего .env, а если его нет — сгенерировать.
# Однажды сгенерированные значения при повторных запусках не меняются.
# POSTGRES_PASSWORD задаётся при первой инициализации базы — позже его
# меняют только SQL-командой внутри контейнера.

POSTGRES_USER=edway
POSTGRES_PASSWORD=
POSTGRES_DB=edway
JWT_SECRET=

# --- Платформа --------------------------------------------------------------

# Логин системного администратора. Временный пароль скрипт выдаст в конце;
# при первом входе его нужно сменить и подключить второй фактор.
ADMIN_LOGIN=admin

# Имя в приложении-аутентификаторе (Яндекс Ключ, Google Authenticator).
TOTP_ISSUER=edway.space

# Сколько дней живёт сессия.
SESSION_DAYS=30

# Попыток входа в минуту с одного адреса.
LOGIN_RATE_LIMIT=20

# --- Обслуживание -----------------------------------------------------------

# Дамп базы и архив загрузок перед каждым развёртыванием (APP_DIR/backups).
BACKUP_BEFORE_DEPLOY=yes

# Сколько копий каждого вида хранить.
BACKUP_KEEP=10
